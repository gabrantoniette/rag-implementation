{
  "uid": "rag-observability",
  "title": "RAG observability",
  "description": "Live logs of the rag-implementation CLI, chat server and browser. Test traffic (env=eval) is hidden.",
  "tags": ["rag"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "rag-cli,rag-chat,rag-browser",
        "multi": true,
        "includeAll": true,
        "allValue": "rag-.*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "debug,info,warn,error",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 11 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "{service=~\"$service\", level=~\"$level\", env!=\"eval\"} | json"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors per minute",
      "gridPos": { "x": 0, "y": 11, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "errors",
          "expr": "sum(count_over_time({service=~\"rag-.*\", env!=\"eval\", level=\"error\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Asks by status (5 min)",
      "gridPos": { "x": 8, "y": 11, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (count_over_time({service=~\"rag-.*\", env!=\"eval\"} | json | event=\"ask.completed\" [5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ask latency p95",
      "gridPos": { "x": 16, "y": 11, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "{{service}}",
          "expr": "quantile_over_time(0.95, {service=~\"rag-.*\", env!=\"eval\"} | json | event=\"ask.completed\" | unwrap totalMs | __error__=\"\" [5m]) by (service)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mean grounding (Full mode answers)",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "{{service}}",
          "expr": "avg_over_time({service=~\"rag-.*\", env!=\"eval\"} | json | event=\"ask.completed\" | unwrap groundingScore | __error__=\"\" [15m]) by (service)"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Browser errors",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "{service=\"rag-browser\", env!=\"eval\"} | json"
        }
      ]
    }
  ]
}
