# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# Neo4j (local Docker from docker-compose.yml, or an AuraDB Free instance).
# For Docker, choose a password of at least 8 characters before running `npm run db:up`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# OpenRouter API key. Only free models are ever called. Leave empty until the live evidence run.
OPENROUTER_API_KEY=
# Optional: pin a free model id (it is still checked against the free allowlist).
OPENROUTER_MODEL=

# Contact for the Wikipedia User-Agent header (a URL or an email address of whoever runs the fetch).
# Required by `npm run ingest:fetch` (Wikimedia User-Agent policy).
WIKIMEDIA_CONTACT=

# Optional: full path to ffmpeg when it is not on PATH (audio and video only).
FFMPEG_PATH=

# Optional: domain folder (default: domains). Example: domains/_template
DOMAIN_DIR=

# debug | info | warn | error
LOG_LEVEL=info
