{
  "name": "rag-implementation",
  "version": "0.1.0",
  "description": "Zero-cost, reusable GraphRAG example in TypeScript: local embeddings, Neo4j vector index plus knowledge graph, TensorFlow.js learning-to-rank, free OpenRouter models with verified citations.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "obs:up": "node scripts/tsx.mjs src/cli/obs.ts up",
    "obs:down": "node scripts/tsx.mjs src/cli/obs.ts down",
    "obs:token": "node scripts/tsx.mjs src/cli/obs-token.ts",
    "ingest:fetch": "node scripts/tsx.mjs src/cli/ingest-fetch.ts",
    "ingest:build": "node scripts/tsx.mjs src/cli/ingest-build.ts",
    "docs": "node scripts/tsx.mjs src/cli/docs.ts",
    "train:intent": "node scripts/tsx.mjs src/cli/train-intent.ts",
    "train:reranker": "node scripts/tsx.mjs src/cli/train-reranker.ts",
    "ask": "node scripts/tsx.mjs src/cli/ask.ts",
    "chat": "node scripts/tsx.mjs src/cli/chat.ts",
    "feedback": "node scripts/tsx.mjs src/cli/feedback.ts",
    "eval:retrieval": "node scripts/tsx.mjs src/cli/eval-retrieval.ts",
    "evidence": "node scripts/tsx.mjs src/cli/evidence.ts",
    "record:build": "node scripts/tsx.mjs src/cli/record-build.ts",
    "scan:secrets": "node scripts/tsx.mjs src/cli/scan-secrets.ts",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@napi-rs/canvas": "1.0.13",
    "@tensorflow/tfjs": "4.22.0",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.9",
    "neo4j-driver": "6.3.0",
    "officeparser": "8.4.0",
    "tesseract.js": "7.0.0",
    "unpdf": "2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/mcp": "0.0.84",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "jszip": "3.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
